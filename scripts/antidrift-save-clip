#!/usr/bin/env python3
"""Trigger Anti-Drift Studio instant replay save from any external shortcut/CLI."""

from __future__ import annotations

import socket
import sys
from pathlib import Path

SOCK = Path.home() / ".cache" / "antidrift-studio" / "clip_trigger.sock"


def main() -> int:
    if not SOCK.exists():
        print("Anti-Drift Studio no está ejecutándose o no escucha atajos.", file=sys.stderr)
        return 1
    arg = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1].isdigit() else "save"
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(2.0)
            s.connect(str(SOCK))
            s.sendall((arg + "\n").encode("utf-8"))
            s.recv(64)
        return 0
    except OSError as exc:
        print(f"Error conectando con Anti-Drift Studio: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
